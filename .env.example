# Django settings
SECRET_KEY=your-secret-key-here-generate-with-django-or-secrets
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL / SQLite)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=ecommerce
DB_USER=django
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Security & SSL Settings (Production Hardening)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Docker environment variables for Postgres
POSTGRES_DB=ecommerce
POSTGRES_USER=django
POSTGRES_PASSWORD=your_password

# Email Configuration
DEFAULT_FROM_EMAIL=orders@aurastore.com

# Stripe Payment Gateway
STRIPE_PUBLISHABLE_KEY=pk_test_aurastore_mock_key
STRIPE_SECRET_KEY=sk_test_aurastore_mock_key
STRIPE_WEBHOOK_SECRET=

